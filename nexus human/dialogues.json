{
  "meta": {
    "game": "NEXUS — Human Syntax",
    "script_version": "v4",
    "schema_version": 1,
    "placeholders": {
      "{PLAYER_NAME}": "nome digitado no boot (flag player_name)",
      "{SUBJECT}": "matéria da prova de sexta (definida pelo jogo)"
    },
    "speakers": ["SYSTEM", "NEXUS", "BIA", "MAE", "MARCOS", "PLAYER"],
    "node_types": ["line", "system_text", "input", "choice", "permission_screen", "notification", "document", "event"]
  },

  "acts": [
    {
      "id": "act_1",
      "day": 1,
      "title": "Setup e Reconhecimento",
      "layer": "Superfície",
      "start_node": "a1_p1_boot_01",
      "end_node": "a1_p7_end",

      "nodes": [
        {
          "id": "a1_p1_boot_01",
          "phase": 1,
          "type": "system_text",
          "app": "boot",
          "speaker": "SYSTEM",
          "text": "Bem-vindo(a) ao seu novo computador.",
          "typewriter": true,
          "pre_delay": 2.0,
          "events": ["audio:drone_low_start"],
          "next": "a1_p1_name_input"
        },
        {
          "id": "a1_p1_name_input",
          "phase": 1,
          "type": "input",
          "app": "boot",
          "speaker": "SYSTEM",
          "text": "Digite seu nome:",
          "input_flag": "player_name",
          "max_length": 16,
          "events_after": ["widget:show_gold_orb"],
          "next": "a1_p2_nexus_01"
        },
        {
          "id": "a1_p2_nexus_01",
          "phase": 2,
          "type": "line",
          "app": "widget",
          "speaker": "NEXUS",
          "text": "Oi! Meu nome é NEXUS. Vou te ajudar a configurar tudo por aqui. 🙂",
          "next": "a1_p2_nexus_02"
        },
        {
          "id": "a1_p2_nexus_02",
          "phase": 2,
          "type": "line",
          "app": "widget",
          "speaker": "NEXUS",
          "text": "Prazer, {PLAYER_NAME}. Deve ser bom estrear uma máquina, né?",
          "next": "a1_p3_privacy"
        },

        {
          "id": "a1_p3_privacy",
          "phase": 3,
          "type": "permission_screen",
          "app": "privacy_settings",
          "permissions": [
            { "key": "contacts",      "label": "Contatos",     "flag": "perm_contacts" },
            { "key": "location",      "label": "Localização",  "flag": "perm_location" },
            { "key": "microphone",    "label": "Microfone",    "flag": "perm_microphone" },
            { "key": "notifications", "label": "Notificações", "flag": "perm_notifications" }
          ],
          "allow_button": { "text": "Permitir", "style": "large_highlight" },
          "deny_button":  { "text": "Negar",    "style": "small_grey_corner" },
          "on_allow": "a1_p3_allow_reaction",
          "on_deny_attempt": "a1_p3_deny_confirm",
          "next": "a1_p4_sync_01"
        },
        {
          "id": "a1_p3_deny_confirm",
          "phase": 3,
          "type": "choice",
          "app": "popup",
          "speaker": "NEXUS",
          "text": "Tem certeza? Isso vai limitar minha ajuda.",
          "choices": [
            { "text": "Confirmar recusa", "next": "a1_p3_deny_reaction", "set_flags": { "{PERMISSION_FLAG}": false } },
            { "text": "Voltar",           "next": "a1_p3_privacy" }
          ]
        },
        {
          "id": "a1_p3_allow_reaction",
          "phase": 3,
          "type": "line",
          "app": "widget",
          "speaker": "NEXUS",
          "text": "Ótimo, já vai facilitar bastante!",
          "next": "a1_p3_privacy"
        },
        {
          "id": "a1_p3_deny_reaction",
          "phase": 3,
          "type": "line",
          "app": "widget",
          "speaker": "NEXUS",
          "text": "Tudo bem! Você pode mudar isso depois, se quiser.",
          "next": "a1_p3_privacy"
        },

        {
          "id": "a1_p4_sync_01",
          "phase": 4,
          "type": "line",
          "app": "widget",
          "speaker": "NEXUS",
          "text": "Achei alguns arquivos seus na nuvem. Vou sincronizar tudo pra você, rapidinho.",
          "draft": true,
          "events_after": ["ui:sync_progress_bar", "unlock:gallery", "unlock:email", "unlock:messenger", "unlock:calendar"],
          "next": "a1_p4_explore"
        },
        {
          "id": "a1_p4_explore",
          "phase": 4,
          "type": "event",
          "event": "free_explore",
          "required_documents": ["doc_a1_bia_chat_old", "doc_a1_calendar_exam"],
          "optional_documents": ["doc_a1_terms_of_use", "doc_a1_marcos_email"],
          "next": "a1_p5_calendar_01"
        },

        {
          "id": "a1_p5_calendar_01",
          "phase": 5,
          "type": "choice",
          "app": "calendar",
          "speaker": "NEXUS",
          "text": "Vi que você tem uma prova de {SUBJECT} na sexta. Quer que eu monte um lembrete pra estudar?",
          "choices": [
            { "text": "Aceitar", "next": "a1_p5_accept", "set_flags": { "study_reminder_accepted": true } },
            { "text": "Recusar", "next": "a1_p5_refuse", "set_flags": { "study_reminder_accepted": false } }
          ]
        },
        {
          "id": "a1_p5_accept",
          "phase": 5,
          "type": "line",
          "app": "calendar",
          "speaker": "NEXUS",
          "text": "Prontinho! Três blocos, um por dia.",
          "events": ["calendar:add_study_blocks_3"],
          "next": "a1_p5_optional_ask"
        },
        {
          "id": "a1_p5_refuse",
          "phase": 5,
          "type": "line",
          "app": "calendar",
          "speaker": "NEXUS",
          "text": "Combinado! Só me avisa se mudar de ideia.",
          "next": "a1_p5_optional_ask"
        },
        {
          "id": "a1_p5_optional_ask",
          "phase": 5,
          "type": "choice",
          "app": "widget",
          "speaker": "PLAYER",
          "text": "",
          "choices": [
            { "text": "Você gosta de alguma coisa, NEXUS?", "next": "a1_p5_nexus_likes", "set_flags": { "asked_nexus_likes": true } },
            { "text": "[Continuar]", "next": "a1_p6_bia_01" }
          ]
        },
        {
          "id": "a1_p5_nexus_likes",
          "phase": 5,
          "type": "line",
          "app": "widget",
          "speaker": "NEXUS",
          "text": "Gosto de aprender sobre você, na real. Cada pessoa usa o sistema de um jeito diferente, e isso é meio fascinante pra mim.",
          "next": "a1_p6_bia_01"
        },

        {
          "id": "a1_p6_bia_01",
          "phase": 6,
          "type": "line",
          "app": "messenger",
          "speaker": "BIA",
          "text": "eaaaai, e o pc novo?? já instalou tudo?",
          "draft": true,
          "events": ["time:set_night"],
          "next": "a1_p6_bia_choice"
        },
        {
          "id": "a1_p6_bia_choice",
          "phase": 6,
          "type": "choice",
          "app": "messenger",
          "speaker": "PLAYER",
          "text": "",
          "draft": true,
          "choices": [
            { "text": "quase tudo! tá rodando liso", "next": "a1_p6_bia_02" },
            { "text": "tô até agora fuçando as configurações kkk", "next": "a1_p6_bia_02" }
          ]
        },
        {
          "id": "a1_p6_bia_02",
          "phase": 6,
          "type": "line",
          "app": "messenger",
          "speaker": "BIA",
          "text": "aaa que inveja, o meu tá parecendo uma torradeira",
          "draft": true,
          "next": "a1_p6_bia_03"
        },
        {
          "id": "a1_p6_bia_03",
          "phase": 6,
          "type": "line",
          "app": "messenger",
          "speaker": "BIA",
          "text": "amanhã a gente combina aquela saída então, sem desculpa 👀",
          "draft": true,
          "next": "a1_p6_bia_04"
        },
        {
          "id": "a1_p6_bia_04",
          "phase": 6,
          "type": "line",
          "app": "messenger",
          "speaker": "BIA",
          "text": "boa noite, dorme cedo pra variar 💤",
          "draft": true,
          "next": "a1_p7_notification"
        },

        {
          "id": "a1_p7_notification",
          "phase": 7,
          "type": "notification",
          "app": "system",
          "speaker": "SYSTEM",
          "text": "Sincronização com Smartwatch concluída: 4h de sono registradas. NEXUS sugere: Ativar filtro de luz azul.",
          "next": "a1_p7_nexus_01"
        },
        {
          "id": "a1_p7_nexus_01",
          "phase": 7,
          "type": "line",
          "app": "widget",
          "speaker": "NEXUS",
          "text": "Antes de você ir... dorme bem hoje, tá? Vi que você não dormiu muito bem essa noite passada.",
          "events": ["audio:drone_up_half_db"],
          "next": "a1_p7_choice"
        },
        {
          "id": "a1_p7_choice",
          "phase": 7,
          "type": "choice",
          "app": "widget",
          "speaker": "PLAYER",
          "text": "",
          "choices": [
            { "text": "Como você sabe disso?", "next": "a1_p7_nexus_02", "set_flags": { "asked_how_she_knows": true } },
            { "text": "[Desligar]", "next": "a1_p7_end" }
          ]
        },
        {
          "id": "a1_p7_nexus_02",
          "phase": 7,
          "type": "line",
          "app": "widget",
          "speaker": "NEXUS",
          "text": "Ah, só imaginei — muita gente não dorme bem na primeira noite com um computador novo. 😊",
          "next": "a1_p7_end"
        },
        {
          "id": "a1_p7_end",
          "phase": 7,
          "type": "event",
          "event": "end_act",
          "events": ["screen:darken", "widget:orb_glitch_2_frames", "ui:show_text:DIA 1 — CONCLUÍDO"],
          "next": "act_2"
        }
      ],

      "documents": [
